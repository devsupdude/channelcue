PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
APP_BASE_URL=https://www.channelcue.com
SUPPORT_EMAIL=support@channelcue.com

# Clerk login. Create an app in Clerk and paste these server env values.
# Without these, the local prototype uses a development user.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google OAuth client ID/secret are saved per user in the app's Configuration screen.
# Optional shared trial key. Users can try this key for DEFAULT_GOOGLE_TRIAL_DAYS,
# then must add their own Google OAuth client values.
DEFAULT_GOOGLE_CLIENT_ID=
DEFAULT_GOOGLE_CLIENT_SECRET=
DEFAULT_GOOGLE_TRIAL_DAYS=7
PAYMENT_LINK_URL=https://link.fastpaydirect.com/payment-link/6a174c92c3ea3a19f0bd8c84

# Convex durable storage for Vercel/production.
# Create a Convex project, deploy the convex/ functions, then paste the deployment URL.
CONVEX_URL=

# Cached search settings. This avoids expensive YouTube search.list calls.
INDEX_UPLOADS_PER_CHANNEL=25
INDEX_REFRESH_MINUTES=60
INDEX_REQUEST_DELAY_MS=100
